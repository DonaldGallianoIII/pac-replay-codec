{
  "name": "pac-replay-codec",
  "version": "1.0.1",
  "description": "Lossless codec for Pokemon Auto Chess replays: up to 12.4x smaller than the raw file, exact bytes back. Command line tool and library.",
  "keywords": [
    "pokemon-auto-chess",
    "replay",
    "colreplay",
    "colyseus",
    "compression",
    "lossless",
    "range-coder",
    "codec",
    "cli"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/DonaldGallianoIII/pac-replay-codec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonaldGallianoIII/pac-replay-codec.git"
  },
  "bugs": {
    "url": "https://github.com/DonaldGallianoIII/pac-replay-codec/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pac-replay-codec": "cli/pac-replay-codec.mjs"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./web/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cli/",
    "web/lib/",
    "types/",
    "README.md",
    "FORMAT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build:web": "node tools/build-web.mjs",
    "prepack": "node tools/build-web.mjs",
    "chart": "node tools/make-chart.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory web",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "pac-replay-codec-1.0.0": "npm:pac-replay-codec@1.0.0",
    "pac-replay-codec-1.0.1": "npm:pac-replay-codec@1.0.1",
    "terser": "5.51.2",
    "typescript": "^7.0.2"
  }
}
